# Nome do banco de dados
POSTGRES_DB=visage

# Usuário do PostgreSQL
POSTGRES_USER=visage

# Senha do PostgreSQL (obrigatório — não usar a padrão em produção)
POSTGRES_PASSWORD=

# Porta exposta no host (padrão PostgreSQL)
DB_PORT=5432

# ── URI de conexão ao SGBD ─────────────────────────────────────────────────
# Use esta URI para conectar ao banco via DBeaver, TablePlus, psql, Prisma, etc.
# Formato: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<DB_PORT>/<POSTGRES_DB>
#
# Exemplo (substitua a senha):
# DATABASE_URL=postgresql://visage:SUA_SENHA@localhost:5432/visage
#
# No backend, defina DATABASE_URL no arquivo backend/.env com o valor acima.
DATABASE_URL=postgresql://visage:SUA_SENHA@localhost:5432/visage

# ── NOTA IMPORTANTE ────────────────────────────────────────────────────────
# O volume PostgreSQL é montado via Docker: postgres_data:/var/lib/postgresql/data
# Os dados persistem entre restarts (docker compose down/up).
# O arquivo db/.env contém CREDENCIAIS e deve estar no .gitignore.
# Adicione "db/.env" ao .gitignore se não estiver lá.
