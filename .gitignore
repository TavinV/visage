# ── Dependências ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build ────────────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Variáveis de ambiente ────────────────────────────────────────────────────
.env
*.env
.env.local
.env.*.local
!*.env.example
!db/.gitkeep

# ── Logs ─────────────────────────────────────────────────────────────────────
# RULE: "logs/" sem barra na frente casava qualquer pasta chamada "logs" em
# qualquer profundidade — inclusive a rota do console
# frontend/src/app/(super-admin)/admin/logs/, que por isso nunca foi versionada.
# Escopado para a raiz do projeto, onde logs de execução de fato apareceriam.
*.log
/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker volumes locais (dados persistidos em host) ───────────────────────
# Nunca versionar os dados dos volumes Docker nomeados que o Docker monta em:
#   Linux/Mac: ~/.local/share/docker/volumes/
#   Windows:   \\wsl$\docker-desktop-data\version-pack-data\community\docker\volumes\
# Se o volume for montado como bind-mount em diretório local, ignore-o aqui:
postgres_data/
fraud_frames/
redis_data/

# ── Editor e OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
*.swp
*.swo

.idea/
*~
.claude/
.next
.claude