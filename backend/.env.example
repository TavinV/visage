# ============================================================================
# Visage Backend — Variáveis de Ambiente
# ============================================================================
# Copy this file to .env and fill in with actual values
# NUNCA commitar .env — apenas .env.example

# ============================================================================
# API & SERVER
# ============================================================================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Base dos links enviados por email (redefinição de senha, convite de admin, etc.).
# ⚠️ Em produção, aponte para o domínio do FRONTEND, não da API.
#   Exemplo DEV: http://localhost:3001
#   Exemplo PROD: https://visage.app.br
FRONTEND_URL=http://localhost:3001

# ============================================================================
# DATABASE — PostgreSQL 16
# ============================================================================
# Use strong passwords in production. Store securely.
DATABASE_URL=postgresql://visage_user:visage_secure_password_change_me@localhost:5432/Visage_db?schema=public

# ============================================================================
# MASTER_KEY — DEK Encryption (CRITICAL SECURITY)
# ============================================================================
# 256-bit (32 bytes) hex string for AES-256 DEK encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER share, NEVER log, NEVER hardcode.
# Rotate annually or when compromised.
MASTER_KEY=your_256_bit_hex_key_here_64_chars_minimum

# ============================================================================
# JWT — Autenticação Access Token + Refresh Token
# ============================================================================
# Access Token Secret — 256-bit secret para assinar JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_change_in_production

# Access Token — Curta duração (ex: 15m para segurança)
JWT_EXPIRES_IN=15m

# Refresh Token Secret — para assinatura de refresh tokens (opcional no MVP)
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_in_production

# Refresh Token TTL — em segundos (604800 = 7 dias)
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# ============================================================================
# SUPER ADMIN — Credencial de Bootstrap (REGRA CRÍTICA)
# ============================================================================
# ⚠️  O Super Admin é criado UMA ÚNICA VEZ durante o bootstrap (primeiro boot).
# ⚠️  Não há endpoint API para criar outro super_admin.
# ⚠️  Se o super_admin já existe no banco, estas variáveis são IGNORADAS.
#
# SUPER_ADMIN_EMAIL: email único de acesso ao painel administrativo
#   Exemplo: admin@Visage.local (DEV)
#   Exemplo: seu-email@empresa.com (Produção)
SUPER_ADMIN_EMAIL=admin@Visage.local

# SUPER_ADMIN_PASSWORD: senha inicial (≥ 12 caracteres, complexa)
#   ⚠️  Em DEV: simples para testes
#   ⚠️  Em PROD: DEVE ser aleatória forte, armazenada em Secrets Manager
#   Gerar: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SUPER_ADMIN_PASSWORD=SuperAdmin123!ChangeMe

# ============================================================================
# REDIS — Cache e Sessões
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# ============================================================================
# FACE ENGINE — Reconhecimento Facial
# ============================================================================
# URL da engine Python (reconhecimento facial).
FACE_ENGINE_URL=http://localhost:8001

# Timeout para chamadas síncronas à engine (ms).
FACE_ENGINE_TIMEOUT=10000

# API Key compartilhada com a engine (header X-API-Key).
# DEVE ser idêntica à ENGINE_API_KEY do .env da engine.
ENGINE_API_KEY=your_engine_api_key_change_in_production

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
# Format: json | pretty
LOG_FORMAT=pretty

# ============================================================================
# CORS
# ============================================================================
# Domínios permitidos (separados por vírgula em produção).
CORS_ORIGIN=http://localhost:3001,http://localhost:3000

# ============================================================================
# PROXY REVERSO — IP real do cliente na auditoria
# ============================================================================
# Quantos proxies (Nginx, Cloudflare, load balancer) ficam à frente da API.
# A trilha de auditoria registra o IP de origem de cada ação; com 0 atrás de um
# proxy, todo evento sairia com o IP do proxy em vez do IP de quem agiu.
# ATENÇÃO: valor maior que o número real de proxies permite que o cliente forje
# o próprio IP injetando o header X-Forwarded-For.
#   0 = sem proxy (dev local, padrão)
#   1 = um proxy reverso à frente (deploy típico)
TRUST_PROXY_HOPS=0

# ============================================================================
# FRAUD FRAMES — Armazenamento de Frames Fraudulentos
# ============================================================================
# Diretório local ou URL de armazenamento externo para frames fraudulentos.
FRAUD_FRAMES_STORAGE_PATH=./fraud_frames

# Retenção padrão de fraud frames (horas).
FRAUD_RETENTION_HOURS=24

# ============================================================================
# SMTP — Envio de email (credenciais de acesso, redefinição de senha, etc.)
# ============================================================================
# Servidor SMTP usado pelo emailService (backend/src/lib/mailer.ts).
# Em DEV, aponte para um servidor de teste local (ex.: Mailhog/MailDev na
# porta 1025, sem auth) para inspecionar os emails sem enviar de verdade.
SMTP_HOST=localhost
SMTP_PORT=587
# "true" apenas para porta 465 (SSL implícito); com STARTTLS (587) deixe false.
SMTP_SECURE=false
# Deixe SMTP_USER/SMTP_PASSWORD vazios para conectar sem autenticação (ex.: Mailhog).
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@visage.com
SMTP_FROM_NAME=Visage
# Destinatário das solicitações de demonstração enviadas pela landing page.
DEMO_NOTIFY_EMAIL=otavioviniciusads@gmail.com

# ============================================================================
# ============================================================================


# ============================================================================
# FEATURES
# ============================================================================
# Habilitar debug mode (verbose logs, sem otimizações).
DEBUG=false

# Fotos de perfil (usuários não-alunos) e logo da instituição.
# Diferente dos fraud frames, estas imagens NÃO expiram. Em deploy sem volume
# persistente (Railway/nixpacks) elas se perdem no redeploy.
PROFILE_PHOTOS_STORAGE_PATH=./profile_photos
