// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Plans & Tenants
// ============================================================================

model Plan {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(100)
  maxClasses   Int      @default(20) // turmas ativas simultâneas
  priceMonthly Decimal  @db.Decimal(19, 2)
  isActive     Boolean  @default(true)
  tenants      Tenant[]
  createdAt    DateTime @default(now()) @db.Timestamptz()

  @@map("plans")
}

model Tenant {
  id              String    @id @default(uuid())
  planId          String
  plan            Plan      @relation(fields: [planId], references: [id])
  name            String    @db.VarChar(200)
  document        String?   @db.VarChar(14) // CNPJ — apenas dígitos, sem pontuação
  institutionType String    @db.VarChar(20) // 'school' | 'university'
  status          String    @default("trial") @db.VarChar(20) // 'active' | 'suspended' | 'trial' | 'cancelled'
  trialEndsAt     DateTime? @db.Timestamptz()
  timezone        String    @default("America/Sao_Paulo") @db.VarChar(50)

  // Logo da instituição — caminho relativo dentro de PROFILE_PHOTOS_STORAGE_PATH.
  // Servido por GET /tenants/:id/logo (nunca exposto como caminho de disco).
  logoPath      String?   @db.VarChar(500)
  logoUpdatedAt DateTime? @db.Timestamptz()

  // Relations
  settings          TenantSettings?
  keys              TenantKeys?
  users             User[]
  locations         Location[]
  academicPeriods   AcademicPeriod[]
  courses           Course[]
  subjects          Subject[]
  classes           Class[]
  classSubjects     ClassSubject[]
  devices           Device[]
  facialEmbeddings  FacialEmbedding[]
  classSessions     ClassSession[]
  attendanceRecords AttendanceRecord[]
  preAttendances    PreAttendance[]
  recognitionLogs   RecognitionLog[]
  enrollmentTokens  EnrollmentToken[]
  biometricConsents BiometricConsent[]
  auditLogs         AuditLog[]
  authSessions      AuthSession[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@map("tenants")
}

model TenantSettings {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  recognitionThreshold Float   @default(1.10)
  livenessThreshold    Float   @default(0.85)
  livenessEnabled      Boolean @default(true)
  allowManualOverride  Boolean @default(true)

  // Pré-presença
  preAttendanceEnabled   Boolean @default(false)
  preAttendanceWindowMin Int     @default(30)

  // Checkout individual
  individualCheckoutEnabled Boolean @default(false)

  // Fraud frames
  saveFraudFrames     Boolean @default(true)
  fraudRetentionHours Int     @default(24)

  // Cadastro via QR Code
  enrollmentTokenExpiryHours  Int     @default(72) // validade do QR Code em horas
  requireConsentBeforeFacial  Boolean @default(true) // bloqueia facial sem aceite LGPD
  enrollmentMultiFrameCount   Int     @default(3) // frames capturados no cadastro
  livenessThresholdEnrollment Float   @default(0.90) // threshold mais rigoroso no cadastro

  // Identificação do aluno
  // Quais identificadores a secretaria registra no cadastro do aluno:
  // 'cpf' | 'enrollment_code' | 'both'. Instituição que não quer guardar CPF
  // usa só a matrícula interna.
  studentIdentification String  @default("cpf") @db.VarChar(20)
  // O que o aluno digita no totem para se identificar antes da biometria:
  // 'cpf' | 'enrollment_code' | 'any' (aceita os dois). Sempre um subconjunto
  // do que é registrado — o service ajusta se a combinação for impossível.
  totemIdentification   String  @default("cpf") @db.VarChar(20)
  // Confere os dígitos verificadores do CPF ao cadastrar. Desligado, o CPF
  // continua exigindo 11 dígitos, mas aceita números fora do padrão da Receita
  // (útil em bases legadas com documentos digitados errado).
  validateCpf           Boolean @default(true)

  // Totem
  // Template da senha do painel oculto do totem. Aceita {{data}} (DDMM) e
  // {{hora}} (HHMM), ex.: "adminumc{{data}}@{{hora}}". Null = painel sem senha.
  totemPanelPassword String?
  // Fuso do relógio exibido no totem: "local" (dispositivo) ou IANA tz
  // (ex.: "America/Sao_Paulo" para horário de Brasília)
  totemClockTimezone String  @default("local")
  // Falas do totem (orientação do rosto no cadastro, confirmação de cadastro e
  // de exclusão da biometria). Desligado por padrão: o totem fica só com os
  // bipes de sucesso/erro de sempre.
  totemAudioEnabled  Boolean @default(false)
  // Voz das falas: 'telma' | 'eduardo' — mesmo nome da pasta em
  // frontend/public/audio/
  totemVoice         String  @default("telma") @db.VarChar(20)

  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@map("tenant_settings")
}

model TenantKeys {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  dekCt      Bytes // DEK cifrada com MASTER_KEY
  dekIv      Bytes // 12 bytes
  dekTag     Bytes // 16 bytes (tag GCM)
  keyVersion Int   @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@map("tenant_keys")
}

// ============================================================================
// Users & Authentication
// ============================================================================

model User {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String  @db.VarChar(200)
  email          String? @db.VarChar(200)
  passwordHash   String? @db.VarChar(255) // NULL para alunos sem acesso ao painel
  role           String  @db.VarChar(20) // 'super_admin' | 'admin' | 'manager' | 'teacher' | 'student'
  status         String  @default("active") @db.VarChar(20) // 'active' | 'inactive' | 'pending'
  // CPF — sempre 11 dígitos, apenas números. Com tenant_settings.validate_cpf
  // desligado o service não confere os dígitos verificadores (permite CPF de
  // teste como 111.222.333-44), mas o formato continua sendo cobrado.
  document       String? @db.VarChar(11)
  enrollmentCode String? @db.VarChar(50) // matrícula institucional (opcional)

  // Estado do cadastro biométrico (desnormalizado para queries rápidas)
  // 'none' | 'consent_given' | 'registered' | 'consent_refused' | 'revoked'
  facialStatus String @default("none") @db.VarChar(20)

  // Senha temporária (gerada na criação/reset) exige troca no primeiro acesso
  mustChangePassword Boolean @default(false)

  // Foto de perfil — caminho relativo dentro de PROFILE_PHOTOS_STORAGE_PATH.
  // Enviada pelo próprio usuário. Alunos NÃO têm foto de perfil: o rosto deles
  // só existe como embedding cifrado (LGPD).
  photoPath      String?   @db.VarChar(500)
  photoUpdatedAt DateTime? @db.Timestamptz()

  // Relations
  facialEmbeddings        FacialEmbedding[]
  taughtClassSubjects     ClassSubject[]        @relation("TeacherClassSubjects")
  classSubjectAssignments ClassSubjectTeacher[] @relation("ClassSubjectTeachers")
  createdClassSessions    ClassSession[]        @relation("CreatedBy")
  taughtClassSessions     ClassSession[]        @relation("TeacherClass")
  classEnrollments        ClassEnrollment[]
  attendanceRecords       AttendanceRecord[]
  checkoutReleased        AttendanceRecord[]    @relation("CheckoutReleasedBy")
  adjustedRecords         AttendanceRecord[]    @relation("AdjustedBy")
  preAttendances          PreAttendance[]
  recognitionLogs         RecognitionLog[]
  enrollmentTokens        EnrollmentToken[]     @relation("UserEnrollmentTokens")
  createdEnrollmentTokens EnrollmentToken[]     @relation("TokenCreatedBy")
  biometricConsents       BiometricConsent[]    @relation("UserBiometricConsents")
  revokedConsents         BiometricConsent[]    @relation("ConsentRevokedBy")

  createdAt    DateTime      @default(now()) @db.Timestamptz()
  updatedAt    DateTime      @updatedAt @db.Timestamptz()
  auditLogs    AuditLog[]
  authSessions AuthSession[] @relation("UserAuthSessions")

  // Email é único no sistema inteiro, não só por tenant — evita que a mesma
  // pessoa (ou credencial) apareça duplicada em instituições diferentes.
  @@unique([email])
  @@unique([tenantId, document])
  // Busca do aluno pela matrícula no totem — sem unicidade no banco porque
  // bases legadas costumam ter códigos repetidos; a duplicidade é barrada no
  // cadastro (users.service) e tratada como ambígua na identificação.
  @@index([tenantId, enrollmentCode])
  @@map("users")
}

// ============================================================================
// Facial Recognition
// ============================================================================

model FacialEmbedding {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  embeddingIv  Bytes // 12 bytes
  embeddingTag Bytes // 16 bytes (tag GCM)
  embeddingCt  Bytes // 2048 bytes (512 float32)
  keyVersion   Int    @default(1)
  modelVersion String @default("arcface_r50_v1") @db.VarChar(50)

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@unique([userId, modelVersion])
  @@map("facial_embeddings")
}

model Device {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  deviceFingerprint String    @db.VarChar(255)
  label             String?   @db.VarChar(100)
  apiKeyHash        String    @db.VarChar(255)
  locationId        String?
  location          Location? @relation(fields: [locationId], references: [id])

  isActive        Boolean   @default(true)
  // Libera o fluxo de cadastro biométrico por CPF na tela deste totem
  allowEnrollment Boolean   @default(false)
  lastSeenAt      DateTime? @db.Timestamptz()

  // Calibração por totem — câmera, iluminação e ângulo variam de sala para
  // sala. NULL herda o valor do tenant; preenchido, sobrepõe o tenant.
  recognitionThreshold Float?
  livenessThreshold    Float?
  livenessEnabled      Boolean?
  calibratedAt         DateTime? @db.Timestamptz()
  // Totem de origem quando a calibração foi copiada de outro dispositivo
  calibrationSourceId  String?   @db.VarChar(36)

  recognitionLogs RecognitionLog[]
  auditLogs       AuditLog[]

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@unique([tenantId, deviceFingerprint])
  @@index([apiKeyHash])
  @@index([tenantId, isActive])
  @@map("devices")
}

// ============================================================================
// Locations
// ============================================================================

model Location {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String  @db.VarChar(100)
  address  String? @db.VarChar(300)
  isActive Boolean @default(true)

  classes        Class[]
  devices        Device[]
  preAttendances PreAttendance[]
  classSessions  ClassSession[]

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@map("locations")
}

// ============================================================================
// Academic Structure
// ============================================================================

model AcademicPeriod {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name     String   @db.VarChar(100) // "2026/1"
  startsAt DateTime @db.Date()
  endsAt   DateTime @db.Date()
  isActive Boolean  @default(true)

  courses Course[]

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@map("academic_periods")
}

model Course {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  academicPeriodId String
  academicPeriod   AcademicPeriod @relation(fields: [academicPeriodId], references: [id])

  name String @db.VarChar(200)

  // Grade do curso, definida pela secretaria: quantas aulas cabem num dia e
  // quanto dura cada uma. A unidade é só de apresentação — lessonDurationMin
  // (derivado) é o que o backend usa em cálculo de tempo.
  lessonsPerDay      Int    @default(4)
  lessonDuration     Int    @default(50)
  lessonDurationUnit String @default("minutes") @db.VarChar(10) // 'minutes' | 'hours'

  subjects Subject[]
  classes  Class[]

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@map("courses")
}

/// Catálogo de disciplinas de um curso (ex.: "Matemática" em Técnico em
/// Mecânica). Só nome e sigla — quem leciona, quanta carga e quanto dura a
/// aula é decidido por turma, em ClassSubject: a mesma Matemática pode ter
/// professores, cargas e durações diferentes no 3ºA e no 3ºB.
model Subject {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  name String  @db.VarChar(200)
  code String? @db.VarChar(30) // sigla institucional (ex.: "MAT101")

  isActive Boolean @default(true)

  classSubjects ClassSubject[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([courseId, name])
  @@index([tenantId, courseId])
  @@map("subjects")
}

model Class {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  name String @db.VarChar(100)

  room       String?   @db.VarChar(50)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // A turma é o GRUPO DE ALUNOS; as disciplinas que ela cursa (cada uma com
  // seu professor e sua carga) vivem em ClassSubject.
  classSubjects ClassSubject[]
  enrollments   ClassEnrollment[]

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, courseId])
  @@map("classes")
}

/// Uma disciplina cursada por uma turma: o professor dela naquela turma e a
/// carga horária. É aqui que a chamada e a frequência se penduram — o aluno
/// pode ter 90% em Matemática e 40% em Física na mesma turma.
model ClassSubject {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  /// Professor RESPONSÁVEL por esta disciplina nesta turma — o nome que
  /// aparece em relatórios e o padrão ao abrir a chamada. O time completo
  /// (inclusive ele) vive em `teachers`: uma disciplina pode ser dividida
  /// entre vários professores.
  teacherId String
  teacher   User   @relation("TeacherClassSubjects", fields: [teacherId], references: [id])

  /// Todos os professores habilitados a dar aula desta disciplina na turma.
  teachers ClassSubjectTeacher[]

  /// Aulas seguidas que uma chamada desta disciplina ocupa (geminada = 2).
  /// Base do classesWorth da sessão e do fechamento automático.
  lessonsPerSession Int @default(1)

  /// Aulas previstas no período — denominador real da frequência.
  totalLessonsPlanned Int @default(0)

  /// Duração de UMA aula desta disciplina nesta turma, em minutos. Era
  /// herdada só do Course (uma duração única para o curso inteiro); agora
  /// cada turma-disciplina tem a sua — a mesma Matemática pode durar 50min
  /// no 3ºA e 40min no 3ºB.
  lessonDurationMin Int @default(50)

  classSessions    ClassSession[]
  studentSummaries StudentClassSummary[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  @@unique([classId, subjectId])
  @@index([tenantId, teacherId])
  @@map("class_subjects")
}

/// Professor alocado a uma disciplina de uma turma.
///
/// Existe porque uma disciplina pode ser dividida entre vários professores
/// (teoria e laboratório, docente e monitor, revezamento por bimestre) e todos
/// precisam poder abrir a chamada dela.
model ClassSubjectTeacher {
  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   User   @relation("ClassSubjectTeachers", fields: [teacherId], references: [id], onDelete: Cascade)

  /// Espelha ClassSubject.teacherId — exatamente um por disciplina da turma.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@id([classSubjectId, teacherId])
  @@index([teacherId])
  @@map("class_subject_teachers")
}

model ClassEnrollment {
  classId String
  class   Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enrolledAt DateTime @default(now()) @db.Timestamptz()

  @@id([classId, userId])
  @@map("class_enrollments")
}

/// Frequência acumulada do aluno POR DISCIPLINA da turma.
model StudentClassSummary {
  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  userId String

  classesAttended Int      @default(0)
  classesAbsent   Int      @default(0)
  lastUpdatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@id([classSubjectId, userId])
  @@index([userId])
  @@map("student_class_summary")
}

// ============================================================================
// Attendance
// ============================================================================

model ClassSession {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // A chamada é de uma DISCIPLINA de uma turma, não da turma inteira.
  classSubjectId String
  classSubject   ClassSubject @relation(fields: [classSubjectId], references: [id])

  // Quem efetivamente deu a aula — normalmente o professor da disciplina,
  // mas pode ser um substituto.
  teacherId String
  teacher   User   @relation("TeacherClass", fields: [teacherId], references: [id])

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  // Sala escolhida pelo professor ao abrir a chamada — sobrepõe a sala
  // padrão da turma no matching do totem. Null = usa class.locationId.
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  // Hora REAL em que a aula começou, informada pelo professor ao abrir a
  // chamada. Pode ser anterior a createdAt (professor abriu a chamada 40min
  // depois do início) — é a base do fechamento automático e do cálculo de
  // aulas no checkout individual.
  startedAt DateTime  @default(now()) @db.Timestamptz()
  endedAt   DateTime? @db.Timestamptz()
  status    String    @default("open") @db.VarChar(20) // 'open' | 'closed' | 'cancelled'

  // Derivado da disciplina (subject.lessonsPerSession) — o professor não
  // escolhe. Congelado na sessão para o histórico não mudar se a secretaria
  // reconfigurar a disciplina depois.
  classesWorth Int @default(1)

  // Duração de uma aula em minutos, congelada do curso pelo mesmo motivo.
  lessonDurationMin Int @default(50)

  // startedAt + classesWorth × lessonDurationMin. O job de fechamento
  // automático encerra a chamada quando este instante passa.
  scheduledEndsAt DateTime? @db.Timestamptz()
  autoClosed      Boolean   @default(false)

  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([status, scheduledEndsAt])
  @@map("class_sessions")
}

model AttendanceRecord {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  classSessionId String
  classSession   ClassSession @relation(fields: [classSessionId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status       String    @db.VarChar(20) // 'present' | 'absent' | 'manual' | 'early_checkout'
  recognizedAt DateTime? @db.Timestamptz()
  // Momento em que o totem reconheceu a saída (só depois da liberação)
  checkedOutAt DateTime? @db.Timestamptz()

  // Checkout individual: o professor libera a saída no painel e o totem
  // registra o horário quando o aluno passa. Sem liberação, passar de novo
  // no totem não faz nada.
  checkoutReleasedById String?
  checkoutReleasedBy   User?     @relation("CheckoutReleasedBy", fields: [checkoutReleasedById], references: [id])
  checkoutReleasedAt   DateTime? @db.Timestamptz()

  confidence       Float?
  livenessScore    Float?
  wasPreAttendance Boolean @default(false)

  // Override do professor: quantas aulas esta presença vale nesta sessão
  // (0 = ausente). Null = vale o classesWorth integral da sessão.
  classesCounted Int?

  adjustedById String?
  adjustedBy   User?     @relation("AdjustedBy", fields: [adjustedById], references: [id])
  adjustedAt   DateTime? @db.Timestamptz()

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@unique([classSessionId, userId])
  @@index([tenantId, classSessionId])
  @@index([classSessionId, status])
  @@map("attendance_records")
}

model PreAttendance {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  recognizedAt  DateTime @db.Timestamptz()
  confidence    Float
  livenessScore Float
  expires_at    DateTime @db.Timestamptz()
  consolidated  Boolean  @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@unique([tenantId, locationId, userId, recognizedAt(sort: Desc)])
  @@index([tenantId, locationId, consolidated])
  @@map("pre_attendances")
}

// ============================================================================
// Recognition & Audit
// ============================================================================

model RecognitionLog {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  status         String @db.VarChar(30) // 'identified' | 'not_identified' | 'liveness_failed' | 'no_face_detected'
  confidence     Float?
  livenessScore  Float?
  saturationMean Float?
  processingMs   Int?

  fraudFramePath   String? @db.VarChar(500)
  fraudFrameExists Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, fraudFrameExists])
  @@map("recognition_logs")
}

model AuditCleanupLog {
  id               String   @id @default(uuid())
  runAt            DateTime @default(now()) @db.Timestamptz()
  filesDeleted     Int      @default(0)
  bytesFreed       BigInt   @default(0)
  tenantsProcessed Int      @default(0)
  errorMessage     String?  @db.Text

  @@map("audit_cleanup_logs")
}

/// Sessão de acesso ao console — nasce no login e morre no logout/expiração.
/// Existe para responder "o que este professor fez enquanto esteve logado":
/// todo AuditLog gravado durante a sessão aponta para cá via sessionId.
model AuthSession {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Null depois que o usuário é excluído — o registro do login permanece,
  /// identificado só pelo snapshot abaixo. Apagar a sessão junto com a conta
  /// levaria embora a linha do tempo do que aquela pessoa fez, que é
  /// exatamente o que a auditoria existe para preservar.
  userId   String?
  user     User?  @relation("UserAuthSessions", fields: [userId], references: [id], onDelete: SetNull)

  // Snapshot do ator no momento do login — sobrevive a renomeações e exclusões
  userName  String  @db.VarChar(200)
  userEmail String? @db.VarChar(200)
  userRole  String  @db.VarChar(20)

  ipAddress String? @db.VarChar(45) // IPv4 ou IPv6
  userAgent String? @db.VarChar(500)

  loginAt    DateTime  @default(now()) @db.Timestamptz()
  lastSeenAt DateTime  @default(now()) @db.Timestamptz()
  endedAt    DateTime? @db.Timestamptz()
  /// 'logout' | 'expired' | 'revoked' — null enquanto a sessão está aberta
  endReason  String?   @db.VarChar(20)

  auditLogs AuditLog[]

  @@index([tenantId, loginAt(sort: Desc)])
  @@index([tenantId, userId, loginAt(sort: Desc)])
  @@map("auth_sessions")
}

/// Trilha de auditoria da plataforma. Uma linha por ação relevante, com quem
/// fez, de onde, quando, sobre o quê e — em mudanças — o estado antes e depois.
///
/// RULE: nunca gravar segredo em beforeState/afterState. O diff passa por
/// redactSensitive() (utils/diff.ts), que troca senha/hash/apiKey/embedding por
/// "[redigido]". Linhas de auditoria são imutáveis: só INSERT e SELECT.
model AuditLog {
  id       String  @id @default(uuid())
  /// Null em eventos que ainda não têm instituição (ex.: login falho de e-mail
  /// desconhecido). Só o super_admin enxerga esses.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // ── Ator ────────────────────────────────────────────────────────────────
  /// Quem executou. Null quando o ator é um totem, o sistema ou um anônimo.
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 'user' | 'device' | 'system' | 'anonymous'
  actorType  String       @default("user") @db.VarChar(20)
  /// Snapshot — a trilha continua legível depois que o usuário some
  actorName  String?      @db.VarChar(200)
  actorEmail String?      @db.VarChar(200)
  actorRole  String?      @db.VarChar(20)
  sessionId  String?
  session    AuthSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  /// Totem que originou a ação, quando actorType = 'device'
  deviceId   String?
  device     Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  // ── Evento ──────────────────────────────────────────────────────────────
  /// Chave do catálogo em lib/auditEvents.ts (ex.: 'device.created')
  action   String @db.VarChar(100)
  /// 'auth' | 'user' | 'student' | 'device' | 'consent' | 'data' | 'academic' |
  /// 'attendance' | 'settings' | 'tenant'
  category String @default("system") @db.VarChar(30)
  /// 'info' | 'warning' | 'critical'
  severity String @default("info") @db.VarChar(10)
  /// 'success' | 'failure'
  status   String @default("success") @db.VarChar(10)

  // ── Alvo ────────────────────────────────────────────────────────────────
  targetType  String? @db.VarChar(40) // 'user' | 'device' | 'class' | ...
  targetId    String?
  /// Nome legível do alvo no momento da ação (o registro pode nem existir mais)
  targetLabel String? @db.VarChar(200)

  // ── Mudança ─────────────────────────────────────────────────────────────
  beforeState   Json?
  afterState    Json?
  /// Campos que mudaram — permite filtrar "quem mexeu no limiar" sem varrer JSON
  changedFields String[] @default([])

  // ── Origem ──────────────────────────────────────────────────────────────
  ipAddress     String? @db.VarChar(45)
  userAgent     String? @db.VarChar(500)
  requestMethod String? @db.VarChar(10)
  requestPath   String? @db.VarChar(200)

  /// Texto livre legível (mantido dos registros antigos)
  details  String? @db.Text
  /// Contexto extra específico do evento (motivo, contadores, etc.)
  metadata Json?

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, action, createdAt(sort: Desc)])
  @@index([tenantId, category, createdAt(sort: Desc)])
  @@index([tenantId, userId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ============================================================================
// Enrollment — Cadastro via QR Code
// ============================================================================

model EnrollmentToken {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserEnrollmentTokens", fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 do token bruto — nunca armazenar o token em plaintext
  tokenHash String @unique @db.VarChar(255)

  // 'pending' | 'used' | 'expired' | 'revoked'
  status String @default("pending") @db.VarChar(20)

  expiresAt    DateTime  @db.Timestamptz()
  usedAt       DateTime? @db.Timestamptz()
  usedByDevice String?   @db.VarChar(255) // fingerprint do totem que consumiu

  createdById String
  createdBy   User   @relation("TokenCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@map("enrollment_tokens")
}

model BiometricConsent {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("UserBiometricConsents", fields: [userId], references: [id], onDelete: Cascade)

  // Versão do texto do regulamento exibido (ex: 'v1.0') — rastreabilidade LGPD
  consentTextVersion String   @db.VarChar(20)
  consentedAt        DateTime @db.Timestamptz()
  deviceFingerprint  String   @db.VarChar(255)
  ipAddress          String   @db.VarChar(45) // IPv4 ou IPv6

  isActive  Boolean   @default(true)
  revokedAt DateTime? @db.Timestamptz()

  revokedById String?
  revokedBy   User?   @relation("ConsentRevokedBy", fields: [revokedById], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@index([tenantId, userId])
  @@index([tenantId, isActive])
  @@map("biometric_consents")
}

// ============================================================================
// Marketing — Solicitações de demonstração (landing page pública)
// ============================================================================

// Leads captados pelo formulário público de "Solicitar demonstração".
// Sem tenant: a instituição ainda não existe. Email e telefone são únicos —
// impedem múltiplas tentativas de contato pela mesma pessoa/instituição.
model DemoRequest {
  id              String @id @default(uuid())
  contactName     String @db.VarChar(150)
  institutionName String @db.VarChar(200)
  studentCount    Int // faixa aproximada informada pelo responsável
  email           String @unique @db.VarChar(255)
  phone           String @unique @db.VarChar(20) // apenas dígitos (DDD + número)
  plan            String @default("Escola") @db.VarChar(50) // plano de interesse

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@map("demo_requests")
}
