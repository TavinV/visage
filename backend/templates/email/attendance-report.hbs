<!-- Template: attendance-report.hbs -->
<!-- Contexto: AttendanceReportEmailContext { teacherName, className, sessionDate, presentCount, totalCount, reportUrl } -->

<h1
  style="margin:0 0 8px 0;font-size:24px;font-weight:700;color:#0b1220;line-height:1.3;"
>
  Relatório de chamada
</h1>
<p style="margin:0 0 24px 0;font-size:15px;color:#69788f;line-height:1.6;">
  Olá,
  <strong>{{teacherName}}</strong>. Confira o resumo da chamada realizada em
  <strong>{{sessionDate}}</strong>.
</p>

<!-- Card de resumo -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
  style="margin:0 0 28px 0;background-color:#f6f8fb;border-radius:12px;border:1px solid #e1e7ef;"
>
  <tr>
    <td style="padding:24px 28px;">

      <p
        style="margin:0 0 4px 0;font-size:13px;font-weight:600;color:#69788f;letter-spacing:0.5px;text-transform:uppercase;"
      >
        Turma
      </p>
      <p
        style="margin:0 0 20px 0;font-size:18px;font-weight:700;color:#0b1220;"
      >
        {{className}}
      </p>

      <table
        role="presentation"
        cellspacing="0"
        cellpadding="0"
        border="0"
        width="100%"
      >
        <tr>
          <td width="50%" style="padding-right:12px;">
            <div
              style="background-color:#dcefe4;border-radius:8px;padding:16px;text-align:center;"
            >
              <p
                style="margin:0 0 4px 0;font-size:28px;font-weight:700;color:#1f7a4d;"
              >{{presentCount}}</p>
              <p style="margin:0;font-size:13px;color:#1f7a4d;">Presentes</p>
            </div>
          </td>
          <td width="50%" style="padding-left:12px;">
            <div
              style="background-color:#eef2f7;border-radius:8px;padding:16px;text-align:center;"
            >
              <p
                style="margin:0 0 4px 0;font-size:28px;font-weight:700;color:#364152;"
              >{{totalCount}}</p>
              <p style="margin:0;font-size:13px;color:#69788f;">Total</p>
            </div>
          </td>
        </tr>
      </table>

    </td>
  </tr>
</table>

<!-- CTA -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  style="margin:0 0 24px 0;"
>
  <tr>
    <td style="border-radius:10px;background-color:#2563eb;">
      <a
        href="{{reportUrl}}"
        style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:10px;letter-spacing:0.2px;"
      >
        Ver relatório completo
      </a>
    </td>
  </tr>
</table>

<p style="margin:0;font-size:13px;color:#69788f;line-height:1.6;">
  <a
    href="{{reportUrl}}"
    style="color:#2563eb;text-decoration:none;word-break:break-all;"
  >{{reportUrl}}</a>
</p>