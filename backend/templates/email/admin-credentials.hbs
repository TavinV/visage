<!-- Template: admin-credentials.hbs -->
<!-- Contexto: AdminCredentialsEmailContext { name, institutionName, email, temporaryPassword, dashboardUrl } -->

<h1
  style="margin:0 0 8px 0;font-size:24px;font-weight:700;color:#1a1a2e;line-height:1.3;"
>
  Bem-vindo ao Visage,
  {{name}}!
</h1>
<p style="margin:0 0 24px 0;font-size:15px;color:#6b7280;line-height:1.6;">
  Você foi cadastrado como administrador da instituição
  <strong>{{institutionName}}</strong>. Abaixo estão suas credenciais de acesso
  iniciais.
</p>

<!-- Caixa de credenciais -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
  style="margin:0 0 24px 0;background-color:#f5f3ff;border-radius:8px;border:1px solid #e0d9ff;"
>
  <tr>
    <td style="padding:24px;">
      <p
        style="margin:0 0 12px 0;font-size:13px;font-weight:600;color:#6c63ff;text-transform:uppercase;letter-spacing:0.5px;"
      >
        Suas credenciais de acesso
      </p>
      <table
        role="presentation"
        cellspacing="0"
        cellpadding="0"
        border="0"
        width="100%"
      >
        <tr>
          <td
            style="padding:6px 0;font-size:14px;color:#6b7280;width:80px;vertical-align:top;"
          >
            E-mail
          </td>
          <td
            style="padding:6px 0;font-size:14px;color:#1a1a2e;font-weight:500;word-break:break-all;"
          >
            {{email}}
          </td>
        </tr>
        <tr>
          <td
            style="padding:6px 0;font-size:14px;color:#6b7280;width:80px;vertical-align:top;"
          >
            Senha
          </td>
          <td style="padding:6px 0;">
            <code
              style="font-size:16px;font-family:monospace;font-weight:700;color:#1a1a2e;background-color:#ffffff;border:1px solid #d1c4ff;border-radius:4px;padding:4px 10px;letter-spacing:1px;"
            >{{temporaryPassword}}</code>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<p
  style="margin:0 0 16px 0;font-size:14px;color:#dc2626;font-weight:500;line-height:1.6;"
>
  ⚠️ Por segurança, altere sua senha imediatamente após o primeiro acesso. Esta
  senha temporária é de uso único.
</p>

<!-- CTA -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  style="margin:32px 0;"
>
  <tr>
    <td style="border-radius:6px;background-color:#6c63ff;">
      <a
        href="{{dashboardUrl}}"
        style="display:inline-block;padding:14px 28px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:6px;letter-spacing:0.2px;"
      >
        Acessar painel
      </a>
    </td>
  </tr>
</table>

<p style="margin:0;font-size:13px;color:#9aa0ab;line-height:1.6;">
  Se o botão não funcionar, copie e cole este link no seu navegador:<br />
  <a
    href="{{dashboardUrl}}"
    style="color:#6c63ff;text-decoration:none;word-break:break-all;"
  >{{dashboardUrl}}</a>
</p>