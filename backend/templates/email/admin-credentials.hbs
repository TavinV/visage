<!-- Template: admin-credentials.hbs -->
<!-- Contexto: AdminCredentialsEmailContext { name, institutionName, email, temporaryPassword, dashboardUrl, roleLabel } -->

<h1
  style="margin:0 0 16px 0;font-size:24px;font-weight:700;color:#0b1220;line-height:1.3;"
>
  Bem-vindo ao Visage,
  {{name}}!
</h1>
<p style="margin:0 0 32px 0;font-size:15px;color:#69788f;line-height:1.7;">
  Você foi cadastrado com acesso de <strong>{{roleLabel}}</strong> na
  instituição <strong>{{institutionName}}</strong>. Abaixo estão suas
  credenciais de acesso iniciais.
</p>

<!-- Caixa de credenciais -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
  style="margin:0 0 28px 0;background-color:#eef3ff;border-radius:12px;border:1px solid #dbe6fe;"
>
  <tr>
    <td style="padding:26px 28px;">
      <p
        style="margin:0 0 16px 0;font-size:13px;font-weight:600;color:#2563eb;text-transform:uppercase;letter-spacing:0.5px;"
      >
        Suas credenciais de acesso
      </p>
      <table
        role="presentation"
        cellspacing="0"
        cellpadding="0"
        border="0"
        width="100%"
      >
        <tr>
          <td
            style="padding:8px 0;font-size:14px;color:#69788f;width:80px;vertical-align:top;"
          >
            E-mail
          </td>
          <td
            style="padding:8px 0;font-size:14px;color:#0b1220;font-weight:500;word-break:break-all;"
          >
            {{email}}
          </td>
        </tr>
        <tr>
          <td
            style="padding:8px 0;font-size:14px;color:#69788f;width:80px;vertical-align:top;"
          >
            Senha
          </td>
          <td style="padding:8px 0;">
            <code
              style="font-size:16px;font-family:monospace;font-weight:700;color:#0b1220;background-color:#ffffff;border:1px solid #bfd2fd;border-radius:6px;padding:5px 12px;letter-spacing:1px;"
            >{{temporaryPassword}}</code>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Aviso -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
  style="margin:0 0 36px 0;background-color:#f6ecd4;border-radius:8px;border-left:4px solid #b07410;"
>
  <tr>
    <td style="padding:16px 20px;">
      <p style="margin:0;font-size:14px;color:#7a5108;line-height:1.7;">
        Por segurança, altere sua senha imediatamente após o primeiro acesso.
        Esta senha temporária é de uso único.
      </p>
    </td>
  </tr>
</table>

<!-- CTA -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  style="margin:0 0 32px 0;"
>
  <tr>
    <td style="border-radius:10px;background-color:#2563eb;">
      <a
        href="{{dashboardUrl}}"
        style="display:inline-block;padding:15px 30px;font-size:15px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:10px;letter-spacing:0.2px;"
      >
        Acessar painel
      </a>
    </td>
  </tr>
</table>

<p style="margin:0;font-size:13px;color:#69788f;line-height:1.7;">
  Se o botão não funcionar, copie e cole este link no seu navegador:<br />
  <a
    href="{{dashboardUrl}}"
    style="color:#2563eb;text-decoration:none;word-break:break-all;"
  >{{dashboardUrl}}</a>
</p>