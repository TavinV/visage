<!-- Template: test.hbs -->
<!-- Contexto: { timestamp } -->

<h1
  style="margin:0 0 8px 0;font-size:24px;font-weight:700;color:#1a1a2e;line-height:1.3;"
>
  Email de teste ✓
</h1>
<p style="margin:0 0 24px 0;font-size:15px;color:#6b7280;line-height:1.6;">
  Este é um email de teste do sistema VisageX.
</p>

<p style="margin:0 0 24px 0;font-size:15px;color:#374151;line-height:1.7;">
  Se você recebeu este email, o serviço SMTP foi configurado corretamente e está
  enviando emails com sucesso.
</p>

<!-- Card de informação -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
  style="margin:0 0 24px 0;background-color:#f8f9fc;border-radius:8px;border:1px solid #e8eaed;"
>
  <tr>
    <td style="padding:16px 20px;">
      <p style="margin:0;font-size:13px;color:#6b7280;">
        <strong>Timestamp:</strong>
        {{timestamp}}
      </p>
    </td>
  </tr>
</table>

<p style="margin:0;font-size:13px;color:#9aa0ab;">
  Você pode ignorar este email.
</p>