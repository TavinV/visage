<!-- Template: enrollment-invite.hbs -->
<!-- Contexto: EnrollmentInviteEmailContext { studentName, institutionName, qrCodeUrl, expiresAt, enrollmentUrl? } -->

<h1
  style="margin:0 0 8px 0;font-size:24px;font-weight:700;color:#0b1220;line-height:1.3;"
>
  Seu cadastro biométrico está pronto
</h1>
<p style="margin:0 0 24px 0;font-size:15px;color:#69788f;line-height:1.6;">
  Olá,
  <strong>{{studentName}}</strong>. A instituição
  <strong>{{institutionName}}</strong>
  preparou seu convite de cadastro facial.
</p>

<p style="margin:0 0 20px 0;font-size:15px;color:#364152;line-height:1.7;">
  Para concluir seu cadastro, apresente o QR Code abaixo em qualquer totem de
  atendimento da sua instituição. O processo leva menos de um minuto.
</p>

<!-- QR Code -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
  style="margin:28px 0;background-color:#f6f8fb;border-radius:12px;border:1px solid #e1e7ef;"
>
  <tr>
    <td align="center" style="padding:32px 24px;">
      <img
        src="{{qrCodeUrl}}"
        alt="QR Code de cadastro"
        width="200"
        height="200"
        style="display:block;width:200px;height:200px;border:0;"
      />
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:0 24px 28px 24px;">
      <p style="margin:0;font-size:13px;color:#69788f;text-align:center;">
        Aponte a câmera do totem para este código
      </p>
    </td>
  </tr>
</table>

<!-- Aviso de expiração -->
<table
  role="presentation"
  cellspacing="0"
  cellpadding="0"
  border="0"
  width="100%"
  style="margin:0 0 24px 0;background-color:#f6ecd4;border-radius:8px;border-left:4px solid #b07410;"
>
  <tr>
    <td style="padding:14px 16px;">
      <p style="margin:0;font-size:14px;color:#7a4d0b;line-height:1.6;">
        <strong>Atenção:</strong>
        Este convite expira em
        <strong>{{expiresAt}}</strong>. Após essa data, um novo convite
        precisará ser gerado pela sua instituição.
      </p>
    </td>
  </tr>
</table>

{{#if enrollmentUrl}}
  <p style="margin:0 0 8px 0;font-size:14px;color:#364152;line-height:1.6;">
    Você também pode acessar o totem virtual pelo link abaixo:
  </p>
  <p style="margin:0;font-size:13px;line-height:1.6;">
    <a
      href="{{enrollmentUrl}}"
      style="color:#2563eb;text-decoration:none;word-break:break-all;"
    >{{enrollmentUrl}}</a>
  </p>
{{/if}}