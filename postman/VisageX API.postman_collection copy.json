    {
      "name": "🔐 Auth",
      "description": "Login (Access + Refresh Token), refresh com rotação e logout. Cada login salva os tokens **a nível da coleção** e também numa variável específica do contexto (super admin / UMC / SENAI) para troca rápida.",
      "item": [
        {
          "name": "Login — Super Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const { data } = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "pm.collectionVariables.set('tenantId', data.user.tenantId);",
                  "pm.collectionVariables.set('userId', data.user.id);",
                  "pm.collectionVariables.set('currentRole', data.user.role);",
                  "pm.collectionVariables.set('superAdminAccessToken', data.accessToken);",
                  "pm.collectionVariables.set('superAdminRefreshToken', data.refreshToken);",
                  "console.log('[Auth] Logado como super_admin:', data.user.email);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{superAdminEmail}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Faz login com o Super Admin do bootstrap (env `SUPER_ADMIN_EMAIL`/`SUPER_ADMIN_PASSWORD`).\n\nSalva nas variáveis: `accessToken`, `refreshToken`, `tenantId`, `userId`, `currentRole`, `superAdminAccessToken`, `superAdminRefreshToken`."
          }
        },
        {
          "name": "Login — UMC Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const { data } = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "pm.collectionVariables.set('tenantId', data.user.tenantId);",
                  "pm.collectionVariables.set('userId', data.user.id);",
                  "pm.collectionVariables.set('currentRole', data.user.role);",
                  "pm.collectionVariables.set('umcAccessToken', data.accessToken);",
                  "pm.collectionVariables.set('umcRefreshToken', data.refreshToken);",
                  "pm.collectionVariables.set('umcTenantId', data.user.tenantId);",
                  "console.log('[Auth] Logado como UMC admin:', data.user.email);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{umcEmail}}\",\n  \"password\": \"{{umcPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Login do admin do tenant UMC. Salva também em `umcAccessToken` e `umcTenantId`."
          }
        },
        {
          "name": "Login — SENAI Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const { data } = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "pm.collectionVariables.set('tenantId', data.user.tenantId);",
                  "pm.collectionVariables.set('userId', data.user.id);",
                  "pm.collectionVariables.set('currentRole', data.user.role);",
                  "pm.collectionVariables.set('senaiAccessToken', data.accessToken);",
                  "pm.collectionVariables.set('senaiRefreshToken', data.refreshToken);",
                  "pm.collectionVariables.set('senaiTenantId', data.user.tenantId);",
                  "console.log('[Auth] Logado como SENAI admin:', data.user.email);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{senaiEmail}}\",\n  \"password\": \"{{senaiPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "description": "Login do admin do tenant SENAI. Salva também em `senaiAccessToken` e `senaiTenantId`."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const { data } = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "console.log('[Auth] Tokens rotacionados');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] },
            "description": "Troca o refresh token ativo por um novo par (access + refresh). O refresh antigo é invalidado (rotação)."
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set('accessToken', '');",
                  "pm.collectionVariables.set('refreshToken', '');",
                  "pm.collectionVariables.set('tenantId', '');",
                  "pm.collectionVariables.set('userId', '');",
                  "pm.collectionVariables.set('currentRole', '');",
                  "console.log('[Auth] Sessão encerrada');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] },
            "description": "Revoga o refresh token e limpa as variáveis de sessão da coleção."
          }
        }
      ]
    },

